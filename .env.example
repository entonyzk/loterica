# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Environment & Security
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
LOG_LEVEL="info"

# Secure one-time provisioning for the first super_admin (must match verified Firebase email).
# Ignored automatically once any admin/super_admin exists in the database.
BOOTSTRAP_ADMIN_EMAIL=""

# Cloud SQL (PostgreSQL) runtime variables are injected automatically by AI Studio / Cloud Run.
# Required variables: SQL_HOST, SQL_DB_NAME, SQL_USER, SQL_PASSWORD, SQL_ADMIN_USER, SQL_ADMIN_PASSWORD

# External Python Mathematical Engine (NumPy / SciPy / Pandas)
# Configure when deploying the decoupled math_engine FastAPI service
MATH_ENGINE_URL="http://127.0.0.1:8001"
MATH_ENGINE_TIMEOUT_MS="5000"
